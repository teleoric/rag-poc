    "@langchain/core": "^1.1.39",
    "@langchain/openai": "^1.4.2",
    "@langchain/qdrant": "^1.0.1",
    "@langchain/textsplitters": "^1.0.1",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
